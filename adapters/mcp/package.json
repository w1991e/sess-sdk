{
  "name": "@sess.si/mcp",
  "version": "0.1.0-rc.1",
  "mcpName": "io.github.w1991e/sess",
  "description": "Local stdio MCP server that lets an agent ask a person through a hosted SESS form and receive a receipt-verified answer.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w1991e/sess-sdk.git",
    "directory": "adapters/mcp"
  },
  "bugs": {
    "url": "https://github.com/w1991e/sess-sdk/issues"
  },
  "homepage": "https://github.com/w1991e/sess-sdk/tree/master/adapters/mcp#readme",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "bin": {
    "sess-mcp": "dist/bin.js"
  },
  "exports": {
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "compatibility.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "node scripts/sdk-candidate.mjs setup --require-registry",
    "candidate:prepare": "node scripts/sdk-candidate.mjs prepare",
    "sdk:switch-to-registry": "node scripts/sdk-candidate.mjs switch-to-registry",
    "sdk:verify": "node scripts/sdk-candidate.mjs verify --require-registry",
    "candidate:verify": "node scripts/sdk-candidate.mjs verify",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "listing": "npm run build && node scripts/listing.mjs write",
    "check:listing": "npm run build && node scripts/listing.mjs check",
    "release:self-test": "node --test scripts/test-release-guard.mjs",
    "sdk:self-test": "node --test scripts/test-sdk-verify.mjs",
    "check": "npm run sdk:verify && npm run sdk:self-test && npm run build && npm run typecheck && node scripts/listing.mjs check && npm test && npm run release:self-test && npm run check:package",
    "runtime-round": "node scripts/runtime-round.mjs",
    "qualify:claude-code": "node scripts/qualify-claude-code.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@sess.si/sdk": "0.1.0-rc.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
