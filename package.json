{
  "name": "@sess.si/sdk",
  "version": "0.1.0-rc.10",
  "description": "Ask a person from your server and continue with their verified answer. Sess API client with receipt and webhook verification.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w1991e/sess-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/w1991e/sess-sdk/issues"
  },
  "homepage": "https://github.com/w1991e/sess-sdk#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./receipts": {
      "types": "./dist/receipts/index.d.ts",
      "import": "./dist/receipts/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "import": "./dist/qr/index.js"
    }
  },
  "bin": {
    "sess": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "generate": "node scripts/check-contract.mjs --write",
    "check:contract": "node scripts/check-contract.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:packed-hygiene": "node --test scripts/test-packed-hygiene.mjs",
    "check": "npm run check:contract && npm run check:spec && npm run check:format && npm run build && npm run typecheck && npm test && npm run check:docs && npm run check:secrets && npm run check:packed-hygiene && npm run check:package && npm run check:pin",
    "check:pin": "node scripts/sdk-pin.mjs verify",
    "pin:update": "node scripts/sdk-pin.mjs update",
    "check:format": "prettier --check .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:source-history": "node scripts/scan-source-history.mjs",
    "check:scan-controls": "node --test scripts/test-source-scan.mjs",
    "check:spec": "node scripts/check-spec.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "jose": "6.2.12",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-current": "npm:typescript@7.0.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "minimatch": "11.0.1"
    }
  }
}
